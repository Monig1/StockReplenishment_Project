@page "/requests/create"
@using MudBlazor
@using StockReplenishment.DTOs
@using StockReplenishment.Models
@using StockReplenishment.Services
@rendermode InteractiveServer

@inject ReplenishmentApiClient ApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Create Request</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Create Replenishment Request</MudText>

<EditForm Model="formModel" OnValidSubmit="SaveDraft">
    <DataAnnotationsValidator />

    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="int" Label="Stock Location" @bind-Value="formModel.LocationId" Required="true">
                    @foreach (var location in locations)
                    {
                        <MudSelectItem Value="@location.Id">
                            @location.Code - @location.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="RequestPriority" Label="Priority" @bind-Value="formModel.Priority">
                    @foreach (var priority in Enum.GetValues<RequestPriority>())
                    {
                        <MudSelectItem Value="@priority">@priority</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h6" Class="mt-6 mb-2">Material Items</MudText>

        @for (var index = 0; index < formModel.Items.Count; index++)
        {
            var item = formModel.Items[index];

            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudTextField Label="Article Number"
                                      @bind-Value="item.ArticleNumber"
                                      Required="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField Label="Description"
                                      @bind-Value="item.Description"
                                      Required="true" />
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudNumericField T="int"
                                         Label="Requested Quantity"
                                         Min="1"
                                         @bind-Value="item.RequestedQuantity"
                                         Required="true" />
                    </MudItem>

                    <MudItem xs="12" md="2" Class="d-flex align-center">
                        <MudButton Color="Color.Error"
                                   Variant="Variant.Outlined"
                                   Disabled="@(formModel.Items.Count == 1)"
                                   OnClick="() => RemoveItem(index)">
                            Remove
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudButton Variant="Variant.Outlined" OnClick="AddItem" Class="mt-2">
            Add Item
        </MudButton>

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Outlined" OnClick="Cancel">
                Cancel
            </MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="isSaving">
                Save Draft
            </MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    private readonly CreateRequestDto formModel = new();
    private List<Location> locations = new();
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        locations = await ApiClient.GetLocationsAsync();
        formModel.LocationId = locations.FirstOrDefault()?.Id ?? 0;
        formModel.Items.Add(new CreateRequestItemDto());
    }

    private void AddItem()
    {
        formModel.Items.Add(new CreateRequestItemDto());
    }

    private void RemoveItem(int index)
    {
        if (formModel.Items.Count > 1)
            formModel.Items.RemoveAt(index);
    }

    private async Task SaveDraft()
    {
        isSaving = true;

        try
        {
            var result = await ApiClient.CreateAsync(formModel);
            Snackbar.Add($"Request {result.Id} created as Draft.", Severity.Success);
            Navigation.NavigateTo($"/requests/{result.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/requests");
    }
}
